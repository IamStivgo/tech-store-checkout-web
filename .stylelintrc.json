{
  "extends": ["stylelint-config-standard-scss"],
  "rules": {
    "scss/dollar-variable-empty-line-before": [
      "always",
      { "except": ["first-nested"], "ignore": ["after-comment"] }
    ],
    "selector-class-pattern": [
      "^[a-z][a-zA-Z0-9]*$",
      { "message": "CSS Module classes use camelCase (e.g. .skipLink)" }
    ]
  }
}
